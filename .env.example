# ── Public (safe in the browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Server only: NEVER prefix with NEXT_PUBLIC_, never commit, set these in the hosting environment ──
# Stripe secret key (sk_live_… in production, sk_test_… for local tests)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…): create the endpoint with `node scripts/stripe-webhook.mjs https://your-domain.com`
STRIPE_WEBHOOK_SECRET=
# Optional: a Price from the Stripe Dashboard to use for Premium (e.g. the 15 EUR one). Unset = a $15 USD price is created inline.
STRIPE_PREMIUM_PRICE_ID=
# Supabase service-role key: lets the webhook grant Premium. Bypasses row-level security — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
